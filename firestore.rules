rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // EDIT THIS CONSTANT TO MATCH YOUR VERCEL BLOB DOMAIN
    function blobHostSuffix() {
      return '.blob.vercel-storage.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    function isValidLevel(l) {
      return l in ['beginner', 'intermediate', 'upper-intermediate', 'advanced'];
    }

    function isValidTopic(t) {
      return t in ['science-tech', 'campus-life', 'social-sciences', 'environment', 'business-economics', 'arts-humanities'];
    }

    function isValidTaskType(t) {
      return t in [
        'complete-words',
        'complete_words',
        'daily-life',
        'daily_life',
        'reading-academic',
        'reading_academic',
        'reading-passage',
        'reading',
        'listening-choose-response',
        'listening_choose_response',
        'listening-dialogue',
        'listening_dialogue',
        'listening-conversation',
        'listening_conversation',
        'listening-announcement',
        'listening_announcement',
        'listening-academic-talk',
        'listening_academic_talk',
        'listening-lecture',
        'listening',
        'build-sentence',
        'writing_build_sentence',
        'write-email',
        'writing_email',
        'academic-discussion',
        'writing_discussion',
        'listen-repeat',
        'speaking_listen_repeat',
        'speaking-interview',
        'speaking_interview'
      ];
    }

    function isValidUrl(url) {
      return url is string && url.matches('^https://[a-zA-Z0-9-]+(\\.[a-zA-Z0-9-]+)*\\.blob\\.vercel-storage\\.com/[^?#]*$');
    }

    function isValidAudioClip(clip) {
      return clip is map
        && clip.keys().hasAll(['speaker', 'url'])
        && clip.speaker is string
        && clip.speaker.size() <= 40
        && clip.url is string
        && isValidUrl(clip.url);
    }

    function isValidAudioClips(clips) {
      return clips is list
        && clips.size() > 0
        && clips.size() <= 15
        && isValidAudioClip(clips[0])
        && (clips.size() <= 1 || isValidAudioClip(clips[1]))
        && (clips.size() <= 2 || isValidAudioClip(clips[2]))
        && (clips.size() <= 3 || isValidAudioClip(clips[3]))
        && (clips.size() <= 4 || isValidAudioClip(clips[4]))
        && (clips.size() <= 5 || isValidAudioClip(clips[5]))
        && (clips.size() <= 6 || isValidAudioClip(clips[6]))
        && (clips.size() <= 7 || isValidAudioClip(clips[7]))
        && (clips.size() <= 8 || isValidAudioClip(clips[8]))
        && (clips.size() <= 9 || isValidAudioClip(clips[9]))
        && (clips.size() <= 10 || isValidAudioClip(clips[10]))
        && (clips.size() <= 11 || isValidAudioClip(clips[11]))
        && (clips.size() <= 12 || isValidAudioClip(clips[12]))
        && (clips.size() <= 13 || isValidAudioClip(clips[13]))
        && (clips.size() <= 14 || isValidAudioClip(clips[14]));
    }

    function isValidQuestion(data) {
      return isValidTaskType(data.taskType)
        && data.content is map
        && (!data.keys().hasAll(['schemaVersion']) || data.schemaVersion is number || data.schemaVersion is string)
        && (!data.keys().hasAll(['contentHash']) || (data.contentHash is string && data.contentHash.size() <= 200))
        && (!data.keys().hasAll(['useCount']) || (data.useCount is number && data.useCount >= 0))
        && (!data.keys().hasAll(['audioUrl']) || data.audioUrl == null || (data.audioUrl is string && isValidUrl(data.audioUrl)))
        && (!data.keys().hasAll(['audioClips']) || data.audioClips == null || isValidAudioClips(data.audioClips));
    }

    function isQuestionIncrementOnly() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.taskType == resource.data.taskType
        && request.resource.data.contentHash == resource.data.contentHash
        && request.resource.data.content == resource.data.content
        && (
          (
            request.resource.data.useCount == resource.data.useCount + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['useCount'])
          ) ||
          (
            (!resource.data.keys().hasAll(['audioUrl']) || resource.data.audioUrl == null || resource.data.audioUrl == '')
            && request.resource.data.audioUrl is string
            && isValidUrl(request.resource.data.audioUrl)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['audioUrl'])
          ) ||
          (
            (!resource.data.keys().hasAll(['audioClips']) || resource.data.audioClips == null || resource.data.audioClips.size() == 0)
            && isValidAudioClips(request.resource.data.audioClips)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['audioClips'])
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['topic', 'level'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['topic']) || (
              !isValidTopic(resource.data.get('topic', ''))
              && isValidTopic(request.resource.data.topic)
            ))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['level']) || (
              !isValidLevel(resource.data.get('level', ''))
              && isValidLevel(request.resource.data.level)
            ))
          )
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Question Bank
    match /questions/{questionId} {
      allow read: if true;

      allow create: if isSignedIn() && isValidQuestion(request.resource.data);

      allow update: if isSignedIn()
        || (
          request.resource.data.taskType == resource.data.taskType
          && isValidQuestion(request.resource.data)
          && (
            isQuestionIncrementOnly()
            || isAdmin()
            || (
              request.resource.data.get('id', questionId) == resource.data.get('id', questionId)
              && request.resource.data.taskType == resource.data.taskType
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
              && request.resource.data.reportCount == (resource.data.get('reportCount', 0) + 1)
              && !exists(/databases/$(database)/documents/questionReports/$(questionId + '__' + request.auth.uid))
              && existsAfter(/databases/$(database)/documents/questionReports/$(questionId + '__' + request.auth.uid))
            )
          )
        );

      allow delete: if isSignedIn() || isAdmin();
    }

    // Isolated Coach & Marathon Mode Question Bank
    match /coach_questions/{questionId} {
      allow read: if true;

      allow create: if isSignedIn() && isValidQuestion(request.resource.data);

      allow update: if isSignedIn()
        || (
          request.resource.data.taskType == resource.data.taskType
          && isValidQuestion(request.resource.data)
          && (
            isQuestionIncrementOnly()
            || isAdmin()
            || (
              request.resource.data.get('id', questionId) == resource.data.get('id', questionId)
              && request.resource.data.taskType == resource.data.taskType
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
              && request.resource.data.reportCount == (resource.data.get('reportCount', 0) + 1)
              && !exists(/databases/$(database)/documents/questionReports/$(questionId + '__' + request.auth.uid))
              && existsAfter(/databases/$(database)/documents/questionReports/$(questionId + '__' + request.auth.uid))
            )
          )
        );

      allow delete: if isSignedIn() || isAdmin();
    }

    // Dedicated Full Mock Exam Sets Database
    match /mock_exam_sets/{setId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Deleted Questions Blocklist (Dev Admin)
    match /deleted_questions/{qId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Applet Users Directory & Presence Tracking
    match /app_users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // Global User Reports
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['text', 'username', 'context', 'uid', 'createdAt', 'resolved'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.resolved == false;
      allow read, update, delete: if isSignedIn();
    }

    // Per-Question User Reports
    match /questionReports/{reportDocId} {
      allow create: if isSignedIn()
        && reportDocId == request.resource.data.questionId + '__' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['questionId', 'uid', 'reason', 'createdAt']);
      allow read, update, delete: if isSignedIn();
    }

    // Per-User Progress (seen question IDs)
    match /userProgress/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /completions/{completionId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /mistakes/{mistakeId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    match /vocabulary/{wordId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    match /userStats/{uid} {
      allow read, create, update, delete: if isSignedIn() && uid == request.auth.uid;

      match /completedDays/{dayId} {
        allow read, create, update: if isSignedIn() && uid == request.auth.uid;
        allow delete: if false;
      }
    }
  }
}
